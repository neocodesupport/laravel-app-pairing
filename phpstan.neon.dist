parameters:
    level: 7
    paths:
        - src
        - config
        - database
        - routes
    tmpDir: build/phpstan
    ignoreErrors:
        -
            # This is a package config template merged into the host application's
            # config via mergeConfigFrom(), not the host's own config/ directory, so
            # Larastan cannot recognize it as config_path() even though it is one.
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/pairing.php
